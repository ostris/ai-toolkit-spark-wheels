+// Minimal dlfcn shim for Windows builds of the Triton NVIDIA backend.
+// Maps POSIX dl* APIs onto Win32 (only what cublas_instance.h needs).
+#ifndef TRITON_WIN_DLFCN_SHIM_H
+#define TRITON_WIN_DLFCN_SHIM_H
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+// windows.h macro leaks that collide with LLVM identifiers
+#ifdef NO_ERROR
+#undef NO_ERROR
+#endif
+#ifdef ERROR
+#undef ERROR
+#endif
+#ifdef OPTIONAL
+#undef OPTIONAL
+#endif
+
+#define RTLD_LAZY 0x1
+#define RTLD_NOW 0x2
+#define RTLD_LOCAL 0x4
+#define RTLD_GLOBAL 0x8
+#define RTLD_NOLOAD 0x10
+
+static inline void *dlopen(const char *name, int flags) {
+  // POSIX library names that callers hardcode -> Windows equivalents
+  if (name && strcmp(name, "libcuda.so.1") == 0)
+    name = "nvcuda.dll";
+  if (flags & RTLD_NOLOAD) {
+    HMODULE mod = NULL;
+    GetModuleHandleExA(0, name, &mod);
+    return (void *)mod;
+  }
+  return (void *)LoadLibraryA(name);
+}
+
+static inline void *dlsym(void *handle, const char *symbol) {
+  return (void *)GetProcAddress((HMODULE)handle, symbol);
+}
+
+static inline int dlclose(void *handle) {
+  return FreeLibrary((HMODULE)handle) ? 0 : -1;
+}
+
+static inline const char *dlerror(void) {
+  static char buf[64];
+  DWORD err = GetLastError();
+  if (err == 0)
+    return NULL;
+  snprintf(buf, sizeof(buf), "win32 error %lu", (unsigned long)err);
+  return buf;
+}
+
+#else
+#include_next <dlfcn.h>
+#endif // _WIN32
+#endif // TRITON_WIN_DLFCN_SHIM_H
